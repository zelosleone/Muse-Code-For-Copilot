{
  "name": "muse-code-for-copilot",
  "displayName": "Muse Code: Copilot Provider",
  "description": "Use your Meta Muse Code subscription in GitHub Copilot Chat.",
  "version": "0.1.2",
  "type": "module",
  "publisher": "DenizhanDaklr",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelosleone/Muse-Code-For-Copilot"
  },
  "homepage": "https://github.com/zelosleone/Muse-Code-For-Copilot#readme",
  "bugs": {
    "url": "https://github.com/zelosleone/Muse-Code-For-Copilot/issues"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "muse",
    "muse code",
    "muse spark",
    "meta",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "muse-code",
        "displayName": "Muse Code",
        "managementCommand": "museCode.manage"
      }
    ],
    "commands": [
      {
        "command": "museCode.manage",
        "title": "Muse Code: Manage"
      },
      {
        "command": "museCode.signIn",
        "title": "Muse Code: Sign In"
      },
      {
        "command": "museCode.signOut",
        "title": "Muse Code: Sign Out"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3"
  }
}
